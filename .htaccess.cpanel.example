# cPanel reverse-proxy example for the Node.js portfolio.
#
# 1. Copy this file to public_html/.htaccess (or the document root of the
#    domain/subdomain in cPanel).
# 2. Replace __PORT__ with the port cPanel shows for the Node.js app.
# 3. Keep the Node.js application root OUTSIDE public_html, for example
#    ~/portfolio, with server.js at its top level.
#
# Next.js serves /_next/static/* and /images/* itself, so every request is
# proxied. Do not add -f/-d exclusions unless you intentionally serve some
# files directly with Apache.

# Uncomment after SSL is installed if cPanel does not already force HTTPS:
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteEngine On
RewriteRule ^(.*)$ http://127.0.0.1:__PORT__/$1 [P,L,QSA]
