41:[["$","h2",null,{"id":"why-accuracy-is-not-enough","children":"Why accuracy is not enough"}],"\n",["$","p",null,{"children":"A classifier that predicts \"no\" for every sample can look impressive on an imbalanced dataset. Before celebrating a score, ask what the model is measured on and what mistakes cost in the real world. This note is a placeholder essay that demonstrates the article layout, code, tables, images and math."}],"\n",["$","h2",null,{"id":"start-with-the-split","children":"Start with the split"}],"\n",["$","p",null,{"children":"Keep a test set untouched until the very end. If you tune against it, it stops being a test set and becomes another training set."}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Use a stratified split when classes are imbalanced."}],"\n",["$","li",null,{"children":"Group related samples together when they come from the same user or session."}],"\n",["$","li",null,{"children":"Record the random seed and the exact preprocessing steps."}],"\n"]}],"\n",["$","figure",null,{"data-rehype-pretty-code-figure":"","children":["$","pre",null,{"tabIndex":"0","data-language":"python","data-theme":"github-light github-dark","children":["$","code",null,{"data-language":"python","data-theme":"github-light github-dark","style":{"display":"grid"},"children":[["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"},"children":"from"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":" sklearn.model_selection "}],["$","span",null,{"style":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"},"children":"import"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":" train_test_split"}]]}],"\n",["$","span",null,{"data-line":"","children":" "}],"\n",["$","span",null,{"data-line":"","children":[["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":"X_