# Copy to .env.local for local development. For cPanel, enter the same values
# in Node.js Selector -> Environment Variables BEFORE running the build.
# Never commit real secrets.

# Public site URL, no trailing slash. Used for canonical URLs, OG images,
# sitemap and RSS. NEXT_PUBLIC_* values are baked into the build, so set this
# before `npm run build:cpanel`.
NEXT_PUBLIC_SITE_URL=https://prachyabiswas.com

# Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=
